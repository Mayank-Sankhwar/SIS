model ImportJob {
  id             String          @id @default(uuid()) @db.Uuid
  uploadedFileId String          @map("uploaded_file_id") @db.Uuid
  importType     ImportType      @map("import_type")
  status         ImportJobStatus @default(PENDING)
  totalRows      Int             @default(0) @map("total_rows")
  successRows    Int             @default(0) @map("success_rows")
  failedRows     Int             @default(0) @map("failed_rows")
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdById    String          @map("created_by") @db.Uuid
  updatedById    String?         @map("updated_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  uploadedFile   UploadedFile    @relation("UploadedFileImportJobs", fields: [uploadedFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy      User            @relation("ImportJobsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy      User?           @relation("ImportJobsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  errors         ImportError[]   @relation("ImportJobErrors")

  @@index([uploadedFileId], map: "idx_import_jobs_uploaded_file_id")
  @@index([status], map: "idx_import_jobs_status")
  @@index([importType], map: "idx_import_jobs_import_type")
  @@index([createdById], map: "idx_import_jobs_created_by")
  @@index([updatedById], map: "idx_import_jobs_updated_by")
  @@index([createdAt], map: "idx_import_jobs_created_at")
  @@map("import_jobs")
}

model ImportError {
  id           String    @id @default(uuid()) @db.Uuid
  importJobId  String    @map("import_job_id") @db.Uuid
  sheetName    String?   @map("sheet_name") @db.VarChar(150)
  rowNumber    Int       @map("row_number")
  columnName   String?   @map("column_name") @db.VarChar(150)
  fieldName    String?   @map("field_name") @db.VarChar(150)
  rawValue     String?   @map("raw_value")
  errorCode    String    @map("error_code") @db.VarChar(100)
  errorMessage String    @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  importJob    ImportJob @relation("ImportJobErrors", fields: [importJobId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([importJobId], map: "idx_import_errors_import_job_id")
  @@index([importJobId, rowNumber], map: "idx_import_errors_import_job_id_row_number")
  @@index([errorCode], map: "idx_import_errors_error_code")
  @@map("import_errors")
}

