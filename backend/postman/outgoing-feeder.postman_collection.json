{
  "info": {
    "name": "Outgoing Feeder CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "eeToken",
      "value": ""
    },
    {
      "key": "aeToken",
      "value": ""
    },
    {
      "key": "jeToken",
      "value": ""
    },
    {
      "key": "substationId",
      "value": ""
    },
    {
      "key": "outsideSubstationId",
      "value": ""
    },
    {
      "key": "outgoingFeederId",
      "value": ""
    },
    {
      "key": "deletedOutgoingFeederId",
      "value": ""
    },
    {
      "key": "discomId",
      "value": ""
    },
    {
      "key": "zoneId",
      "value": ""
    },
    {
      "key": "verticalId",
      "value": ""
    },
    {
      "key": "subVerticalId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"substationId\": \"{{substationId}}\",\n  \"feederName\": \"Postman Outgoing Feeder\",\n  \"feederCode\": \"PM-OF-001\",\n  \"voltageLevelKv\": 11,\n  \"feederType\": \"INDUSTRIAL\",\n  \"connectedLoadMw\": 18.5,\n  \"isActive\": true\n}"
        }
      }
    },
    {
      "name": "Get",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders/{{outgoingFeederId}}"
      }
    },
    {
      "name": "List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders"
      }
    },
    {
      "name": "Search",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders?search=Postman"
      }
    },
    {
      "name": "Pagination",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders?page=1&limit=10&sortBy=feederName&sortOrder=asc"
      }
    },
    {
      "name": "Filter by Feeder Type",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders?feederType=INDUSTRIAL"
      }
    },
    {
      "name": "Update",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders/{{outgoingFeederId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"feederType\": \"RESIDENTIAL\",\n  \"voltageLevelKv\": 11,\n  \"connectedLoadMw\": 12.75,\n  \"isActive\": true\n}"
        }
      }
    },
    {
      "name": "Delete",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders/{{outgoingFeederId}}"
      }
    },
    {
      "name": "Unauthorized",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/outgoing-feeders"
      }
    },
    {
      "name": "Forbidden - JE Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jeToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"substationId\": \"{{substationId}}\",\n  \"feederName\": \"JE Forbidden Feeder\",\n  \"voltageLevelKv\": 11\n}"
        }
      }
    },
    {
      "name": "Forbidden - Outside Area",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{eeToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"substationId\": \"{{outsideSubstationId}}\",\n  \"feederName\": \"Outside Area Feeder\",\n  \"voltageLevelKv\": 11\n}"
        }
      }
    },
    {
      "name": "Duplicate Name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"substationId\": \"{{substationId}}\",\n  \"feederName\": \"Postman Outgoing Feeder\",\n  \"feederCode\": \"PM-OF-002\",\n  \"voltageLevelKv\": 11\n}"
        }
      }
    },
    {
      "name": "Duplicate Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"substationId\": \"{{substationId}}\",\n  \"feederName\": \"Postman Outgoing Feeder 2\",\n  \"feederCode\": \"PM-OF-001\",\n  \"voltageLevelKv\": 11\n}"
        }
      }
    },
    {
      "name": "Soft Delete Retrieval",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders/{{deletedOutgoingFeederId}}"
      }
    },
    {
      "name": "List Include Deleted",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/outgoing-feeders?includeDeleted=true"
      }
    }
  ]
}
