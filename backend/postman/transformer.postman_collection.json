      }
    },
    {
      "name": "Forbidden - JE Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jeToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/transformers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"substationId\": \"{{substationId}}\",\n  \"transformerCode\": \"JE-PTR-001\",\n  \"capacityMva\": 10,\n  \"primaryVoltageKv\": 33,\n  \"secondaryVoltageKv\": 11\n}"
