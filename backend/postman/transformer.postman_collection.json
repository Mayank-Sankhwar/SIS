            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/transformers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"substationId\": \"{{substationId}}\",\n  \"transformerCode\": \"PM-PTR-FUTURE\",\n  \"capacityMva\": 10,\n  \"primaryVoltageKv\": 33,\n  \"secondaryVoltageKv\": 11,\n  \"commissioningDate\": \"2999-01-01\"\n}"
        }
