    {
      "name": "Soft Delete Retrieval",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/transformers/{{deletedTransformerId}}"
      }
    },
    {
      "name": "List Include Deleted",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/transformers?includeDeleted=true"
      }
