        ],
        "url": "{{baseUrl}}/transformers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"substationId\": \"{{substationId}}\",\n  \"transformerCode\": \"PM-PTR-002\",\n  \"capacityMva\": 10,\n  \"primaryVoltageKv\": 33,\n  \"secondaryVoltageKv\": 11,\n  \"serialNumber\": \"PM-TR-001\"\n}"
        }
      }
